rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Players ──────────────────────────────────────────────────────────────
    match /players/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validPlayerCreate();
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && validPlayerUpdate();
      allow delete: if false;
    }

    // ── Duels ─────────────────────────────────────────────────────────────────
    match /duels/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.hostId == request.auth.uid
                        || resource.data.guestId == request.auth.uid
                        || resource.data.guestId == null);
      allow delete: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Validation helpers ────────────────────────────────────────────────────
    function validDisplayName(name) {
      return name is string && name.size() >= 1 && name.size() <= 30;
    }

    function validScore(score) {
      return score is int && score >= 0 && score <= 500000;
    }

    function validPlayerCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'displayName', 'highScore', 'totalScore',
                               'wins', 'totalGames', 'lastUpdated'])
          && d.uid == request.auth.uid
          && validDisplayName(d.displayName)
          && validScore(d.highScore)
          && validScore(d.totalScore)
          && d.wins    is int && d.wins    >= 0
          && d.totalGames is int && d.totalGames >= 0;
    }

    function validPlayerUpdate() {
      let d  = request.resource.data;
      let e  = resource.data;
      return validDisplayName(d.displayName)
          && validScore(d.highScore)
          && validScore(d.totalScore)
          && d.highScore   >= e.highScore
          && d.totalScore  >= e.totalScore
          && d.wins        >= e.wins
          && d.totalGames  >= e.totalGames
          && d.uid         == e.uid;
    }
  }
}

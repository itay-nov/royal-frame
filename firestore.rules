rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validPlayerCreate();
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && (
                      (validPlayerUpdate() && notTooSoon())
                      || validTutorialUpdate()
                      || validStreakUpdate()
                    );
      allow delete: if false;
    }

    match /duels/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.guestUid == null
                    && request.resource.data.status == 'waiting';
      allow update: if request.auth != null
                    && (validDuelJoin() || validDuelParticipantUpdate());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function validDuelJoin() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == 'waiting'
          && resource.data.guestUid == null
          && resource.data.hostUid != request.auth.uid
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 1
          && request.resource.data.guestName.size() <= 30
          && request.resource.data.status == 'active'
          && changed.hasOnly(['guestUid', 'guestName', 'status']);
    }

    function validDuelParticipantUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let common = [
        'status', 'winnerId', 'rematchReady', 'seed', 'abandonedBy'
      ];
      let hostFields = [
        'hostScore', 'hostFinished', 'hostTime', 'hostRoyals'
      ];
      let guestFields = [
        'guestScore', 'guestFinished', 'guestTime', 'guestRoyals'
      ];

      return (resource.data.hostUid == request.auth.uid
              && changed.hasOnly(common.concat(hostFields)))
          || (resource.data.guestUid == request.auth.uid
              && changed.hasOnly(common.concat(guestFields)));
    }

    function validDisplayName(name) {
      return name is string
          && name.size() >= 1
          && name.size() <= 30;
    }

    function validScore(score) {
      return score is int
          && score >= 0
          && score <= 500000;
    }

    function notTooSoon() {
      return !('lastUpdated' in resource.data)
          || request.time > resource.data.lastUpdated + duration.value(30, 's');
    }

    function validPlayerCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'displayName', 'highScore', 'totalScore',
                               'wins', 'totalGames', 'lastUpdated'])
          && d.uid == request.auth.uid
          && validDisplayName(d.displayName)
          && validScore(d.highScore)
          && validScore(d.totalScore)
          && d.highScore   == d.totalScore
          && d.wins        is int && d.wins        >= 0 && d.wins        <= 1
          && d.totalGames  is int && d.totalGames  >= 0 && d.totalGames  <= 1;
    }

    function validPlayerUpdate() {
      let d = request.resource.data;
      let e = resource.data;
      return validDisplayName(d.displayName)
          && validScore(d.highScore)
          && validScore(d.totalScore)
          && d.highScore   >= e.highScore
          && d.totalScore  >= e.totalScore
          && d.wins        >= e.wins
          && d.totalGames  >= e.totalGames
          && d.totalGames  <= e.totalGames + 1
          && d.uid         == e.uid;
    }

    function validTutorialUpdate() {
      let d = request.resource.data;
      let e = resource.data;
      return d.get('hasSeenTutorial', false) == true
          && d.diff(e).affectedKeys().hasOnly(['hasSeenTutorial']);
    }

    function validStreakUpdate() {
      let d = request.resource.data;
      let e = resource.data;
      return d.diff(e).affectedKeys().hasOnly(['streak', 'streakLastDate'])
          && d.uid == e.uid;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && validPlayerCreate();
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && (
                      (validPlayerUpdate() && notTooSoon())
                      || validTutorialUpdate()
                      || validStreakUpdate()
                    );
      allow delete: if false;
    }

    match /duels/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.hostUid == request.auth.uid
                        || resource.data.guestUid == request.auth.uid
                        || resource.data.guestUid == null);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function validDisplayName(name) {
      return name is string
          && name.size() >= 1
          && name.size() <= 30;
    }

    function validScore(score) {
      return score is int
          && score >= 0
          && score <= 500000;
    }

    function notTooSoon() {
      return !('lastUpdated' in resource.data)
          || request.time > resource.data.lastUpdated + duration.value(30, 's');
    }

    function validPlayerCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'displayName', 'highScore', 'totalScore',
                               'wins', 'totalGames', 'lastUpdated'])
          && d.uid == request.auth.uid
          && validDisplayName(d.displayName)
          && validScore(d.highScore)
          && validScore(d.totalScore)
          && d.highScore   == d.totalScore
          && d.wins        is int && d.wins        >= 0 && d.wins        <= 1
          && d.totalGames  is int && d.totalGames  >= 0 && d.totalGames  <= 1;
    }

    function validPlayerUpdate() {
      let d = request.resource.data;
      let e = resource.data;
      return validDisplayName(d.displayName)
          && validScore(d.highScore)
          && validScore(d.totalScore)
          && d.highScore   >= e.highScore
          && d.totalScore  >= e.totalScore
          && d.wins        >= e.wins
          && d.totalGames  >= e.totalGames
          && d.totalGames  <= e.totalGames + 1
          && d.uid         == e.uid;
    }

    function validTutorialUpdate() {
      let d = request.resource.data;
      let e = resource.data;
      return d.get('hasSeenTutorial', false) == true
          && d.diff(e).affectedKeys().hasOnly(['hasSeenTutorial']);
    }

    function validStreakUpdate() {
      let d = request.resource.data;
      let e = resource.data;
      return d.diff(e).affectedKeys().hasOnly(['streak', 'streakLastDate'])
          && d.uid == e.uid;
    }
  }
}
